# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Optional: model used to read the board (default: claude-haiku-5-5, cheapest)
# Bigger models read blurry shots better but cost more per read.
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_MODEL=claude-opus-5-5

# Optional: shared secret. When set, the API only answers requests that send
# "Authorization: Bearer <APP_TOKEN>". Set this before deploying publicly.
# APP_TOKEN=
